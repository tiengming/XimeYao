<?xml version='1.0' encoding='utf-8'?>

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<!-- CUDA 分包开关：默认 0（CPU 包），msi-build.ps1 -Gpu 传 -dWithCudaDlls=1。 -->
<?ifndef WithCudaDlls ?>
    <?define WithCudaDlls = 0 ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='曦码·曜'
        UpgradeCode='4C3D8396-6499-481D-ACD7-5E4A74E4E8A0'
        Manufacturer='Xime Org'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>
        
        <Package Id='*'
            Keywords='Installer'
            Manufacturer='Xime Org'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />
        
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>
        
        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='曦码·曜 Installation'/>
        
        <Property Id='REINSTALLMODE' Value='amus'/>

        <!-- GPU 包的运行库要求写在安装完成的「完成」页上（ExitDialogDescription 里
             展开 [CUDA_NOTE]）：那是每个安装用户都会看到的一屏，而 WixUI_InstallDir
             的界面里没有 feature 树可以显示描述。
             CPU 包只给一个空格（见下方 else 分支的说明）。
             注意这与 CUDA 运行库的**缺失检测**是两件事：真正的探测在 server 里
             （speech::cuda_runtime_ready），因为运行库装在 CUDA 的 bin 目录里、
             靠 PATH 才能找到，MSI 的 FileSearch 探不到，硬做会得出错误结论。 -->
        <?if $(var.WithCudaDlls) = 1 ?>
        <Property Id='CUDA_NOTE' Value='本安装包是 GPU 加速版：语音识别还需要 NVIDIA 驱动附带的 CUDA 13 运行库（cuBLAS）与 cuDNN 9；缺少时自动改用 CPU，不影响输入法本体。'/>
        <?else ?>
        <!-- 不用空串：空值属性在格式化文本里的展开行为不够确定，万一没展开，
             「完成」页会露出字面的 [CUDA_NOTE]。空格最坏就是多一个空格。 -->
        <Property Id='CUDA_NOTE' Value=' '/>
        <?endif ?>
        
        <Directory Id='TARGETDIR' Name='SourceDir'>
            <!-- Start Menu -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='曦码·曜'>
                    <Component Id='ApplicationShortcut' Guid='{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}'>
                        <Shortcut Id='XimeSettingsShortcut'
                            Name='曦码·曜设置'
                            Target='[APPLICATIONFOLDER]winxime-setup.exe'
                            WorkingDirectory='APPLICATIONFOLDER'
                            Icon='ProductICO'/>
                        <RemoveFolder Id='RemoveApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue Root='HKCU' Key='Software\Xime' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
            
            <!-- Application Folder -->
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Xime'>
                    <!-- Main binaries -->
                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='winxime-server.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\winxime-server.exe'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='binary1' Guid='*'>
                        <File
                            Id='exe1'
                            Name='winxime-setup.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\winxime-setup.exe'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='binary2' Guid='*'>
                        <File
                            Id='exe2'
                            Name='winxime-tsf-register.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\winxime-tsf-register.exe'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='tsf_dll' Guid='*'>
                        <File
                            Id='tsf0'
                            Name='winxime_tsf.dll'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\winxime_tsf.dll'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='rime_dll' Guid='*'>
                        <File
                            Id='rime0'
                            Name='rime.dll'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\rime.dll'
                            KeyPath='yes'/>
                    </Component>
                    <!-- 语音（sherpa-onnx）运行库：server 导入表直接引用 c-api，
                         缺了 server 起不来。 -->
                    <Component Id='sherpa_dll' Guid='*'>
                        <File
                            Id='sherpa0'
                            Name='sherpa-onnx-c-api.dll'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\sherpa-onnx-c-api.dll'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='sherpa_cxx_dll' Guid='*'>
                        <File
                            Id='sherpacxx0'
                            Name='sherpa-onnx-cxx-api.dll'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\sherpa-onnx-cxx-api.dll'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='onnxruntime_dll' Guid='*'>
                        <File
                            Id='onnxruntime0'
                            Name='onnxruntime.dll'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\onnxruntime.dll'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='onnxruntime_providers_dll' Guid='*'>
                        <File
                            Id='onnxruntimeproviders0'
                            Name='onnxruntime_providers_shared.dll'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\onnxruntime_providers_shared.dll'
                            KeyPath='yes'/>
                    </Component>
                    <?if $(var.WithCudaDlls) = 1 ?>
                    <!-- CUDA 包专用：onnxruntime 的 CUDA EP 实现（255MB）。
                         它硬依赖 CUDA 13 运行库的 cublas64_13/cublasLt64_13.dll
                         （**不**依赖 cuDNN 9；只有我们不装的 TensorRT EP 才要 cuDNN）。
                         不随包分发 CUDA 运行库（数百 MB），由用户装 CUDA 13 运行库；
                         缺库时 server 探测到就回退 CPU，不会崩。 -->
                    <Component Id='onnxruntime_cuda_dll' Guid='*'>
                        <File
                            Id='onnxruntimecuda0'
                            Name='onnxruntime_providers_cuda.dll'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\onnxruntime_providers_cuda.dll'
                            KeyPath='yes'/>
                    </Component>
                    <?endif?>
                    <Component Id='icon_file' Guid='*'>
                        <File
                            Id='icon0'
                            Name='icon.ico'
                            DiskId='1'
                            Source='resources\icon.ico'
                            KeyPath='yes'/>
                    </Component>
                    
                    <!-- Run startup -->
                    <Component Id='RunStartup' Guid='{EC8A2320-6C0B-CC95-81E0-7F182F4A7BF8}'>
                        <RegistryValue Root='HKLM' Key='SOFTWARE\Microsoft\Windows\CurrentVersion\Run'
                            Name='XimeServer' Type='string' Value='[APPLICATIONFOLDER]winxime-server.exe' KeyPath='yes'/>
                    </Component>
                    
                    <!-- Data folder: rime base data (harvested by heat) -->
                    <Directory Id='DataFolder' Name='data'/>
                    
                    <!-- User-data folder: schema files for first-run deploy (harvested by heat) -->
                    <Directory Id='UserDataFolder' Name='user-data'/>
                    
                    <!-- Resources folder (harvested by heat) -->
                    <Directory Id='ResourcesFolder' Name='resources'/>
                </Directory>
            </Directory>
        </Directory>
        
        <!-- Custom Actions for TSF registration -->
        <Binary Id='tsfreg' SourceFile='$(var.CargoTargetBinDir)\winxime-tsf-register.exe'/>
        
        <CustomAction Id='RegisterTSF' 
            BinaryKey='tsfreg'
            ExeCommand='-copy-and-register "[APPLICATIONFOLDER]winxime_tsf.dll" "[APPLICATIONFOLDER]icon.ico"'
            Execute='deferred'
            Impersonate='no'
            Return='ignore'/>
        
        <CustomAction Id='UnregisterTSF' 
            BinaryKey='tsfreg'
            ExeCommand='-unregister-and-remove'
            Execute='deferred'
            Impersonate='no'
            Return='ignore'/>
        
        <!-- Stop server before uninstall -->
        <CustomAction Id='StopServer' 
            BinaryKey='tsfreg'
            ExeCommand='-stop-server'
            Execute='deferred'
            Impersonate='no'
            Return='ignore'/>
        
        <!-- Start server after install -->
        <SetProperty Id='StartServer' Value='[APPLICATIONFOLDER]winxime-server.exe' Before='StartServer' Sequence='execute'/>
        <CustomAction Id='StartServer' 
            Property='StartServer'
            ExeCommand=''
            Execute='deferred'
            Impersonate='yes'
            Return='asyncNoWait'/>
        
        <InstallExecuteSequence>
            <Custom Action='RegisterTSF' After='InstallFiles'>NOT Installed</Custom>
            <Custom Action='StartServer' Before='InstallFinalize'>NOT Installed</Custom>
            <Custom Action='StopServer' Before='UnregisterTSF'>Installed</Custom>
            <Custom Action='UnregisterTSF' Before='RemoveFiles'>Installed</Custom>
        </InstallExecuteSequence>
        
        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and data.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>
            <ComponentRef Id='binary2'/>
            <ComponentRef Id='tsf_dll'/>
            <ComponentRef Id='rime_dll'/>
            <!-- 语音运行库：server 导入表直接引用，必须随包安装。
                 CUDA EP 只在 GPU 包里存在，跟着同一个开关引用，否则 light
                 会报 ICE21（Component does not belong to any Feature）。 -->
            <ComponentRef Id='sherpa_dll'/>
            <ComponentRef Id='sherpa_cxx_dll'/>
            <ComponentRef Id='onnxruntime_dll'/>
            <ComponentRef Id='onnxruntime_providers_dll'/>
            <?if $(var.WithCudaDlls) = 1 ?>
            <ComponentRef Id='onnxruntime_cuda_dll'/>
            <?endif?>
            <ComponentRef Id='icon_file'/>
            <ComponentRef Id='RunStartup'/>
            <ComponentRef Id='ApplicationShortcut'/>
        </Feature>
        
        <!-- Include harvested data and resources -->
        <Feature Id='DataFiles' Level='1'>
            <ComponentGroupRef Id='DataFiles'/>
        </Feature>
        <Feature Id='UserDataFiles' Level='1'>
            <ComponentGroupRef Id='UserDataFiles'/>
        </Feature>
        <Feature Id='ResourcesFiles' Level='1'>
            <ComponentGroupRef Id='ResourcesFiles'/>
        </Feature>
        
        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        
        <Icon Id='ProductICO' SourceFile='resources\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />
        
        <!-- Required property for WixUI_InstallDir -->
        <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>
        
        <UI>
            <UIRef Id='WixUI_InstallDir'/>
        </UI>
        
        <WixVariable Id='WixUILicenseRtf' Value='crates\winxime-server\wix\License.rtf'/>
        
    </Product>

</Wix>